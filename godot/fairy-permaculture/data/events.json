[
  {
    "id": "summer-drought",
    "name": "Summer Drought",
    "description": "Consecutive rain-free days stress unirrigated crops.",
    "trigger": {
      "type": "consecutive-rainless-days",
      "params": { "threshold_days": 10 },
      "season": "summer",
      "probability": 0.15
    },
    "severity": "real-loss",
    "effects": [
      { "type": "moisture-loss", "params": { "factor": 2.0, "per": "day" } },
      { "type": "unwatered-yield-penalty", "params": { "min": 0.30, "max": 0.70 } },
      { "type": "sapling-death-risk", "params": { "probability": 0.05 } }
    ],
    "mitigations": [
      { "type": "swale-coverage", "params": { "radius_tiles": 12 }, "reduces_severity_by": 0.6 },
      { "type": "pond-nearby", "params": { "radius_tiles": 8 }, "reduces_severity_by": 0.5 },
      { "type": "healer-fairy-watering", "params": {}, "reduces_severity_by": 0.4 },
      { "type": "mulch-coverage", "params": {}, "reduces_severity_by": 0.3 }
    ],
    "duration_days_range": [5, 20]
  },
  {
    "id": "aphid-outbreak",
    "name": "Aphid Outbreak",
    "description": "Monoculture clusters attract aphid swarms in spring.",
    "trigger": {
      "type": "monoculture-cluster",
      "params": { "same_family_threshold": 4, "radius_tiles": 3 },
      "season": "spring",
      "probability": 0.10
    },
    "severity": "real-loss",
    "effects": [
      { "type": "yield-penalty", "params": { "factor": 0.50 } },
      { "type": "spread-to-neighbors", "params": { "chance_per_day": 0.20 } }
    ],
    "mitigations": [
      { "type": "insectary-proximity", "params": { "species": ["yarrow", "dill", "alyssum"], "radius_tiles": 8 }, "reduces_severity_by": 0.7 },
      { "type": "ladybug-release", "params": {}, "reduces_severity_by": 0.8 },
      { "type": "healer-fairy-treatment", "params": {}, "reduces_severity_by": 0.6 }
    ],
    "duration_days_range": [7, 21]
  },
  {
    "id": "wet-pile-failure",
    "name": "Wet Pile Failure",
    "description": "Heavy rain on an uncovered hot pile turns it anaerobic.",
    "trigger": {
      "type": "rain-on-hot-pile",
      "params": { "consecutive_rain_days": 3 },
      "season": "any",
      "probability": 0.08
    },
    "severity": "nuisance",
    "effects": [
      { "type": "pile-state-change", "params": { "new_state": "anaerobic" } },
      { "type": "quality-cap", "params": { "max_quality": 1 } }
    ],
    "mitigations": [
      { "type": "add-browns-bulkers", "params": {}, "reduces_severity_by": 0.7 },
      { "type": "cover-pile-tarp", "params": {}, "reduces_severity_by": 0.9 },
      { "type": "site-under-canopy", "params": {}, "reduces_severity_by": 0.5 }
    ],
    "duration_days_range": [1, 3]
  },
  {
    "id": "hawk-strike",
    "name": "Hawk Strike",
    "description": "A hawk targets chickens on open daytime pasture.",
    "trigger": {
      "type": "open-pasture-daylight",
      "params": { "flock_size_min": 3, "canopy_cover_below": 0.3 },
      "season": "any",
      "probability": 0.05
    },
    "severity": "real-loss",
    "effects": [
      { "type": "lose-animals", "params": { "min": 1, "max": 3, "species": ["chicken-layer"] } }
    ],
    "mitigations": [
      { "type": "canopy-cover", "params": { "fraction_min": 0.3 }, "reduces_severity_by": 0.8 },
      { "type": "guard-animal-nearby", "params": { "species": ["goose-embden", "lgd_dog"] }, "reduces_severity_by": 0.7 },
      { "type": "chicken-tractor-under-canopy", "params": {}, "reduces_severity_by": 0.9 }
    ],
    "duration_days_range": [1, 1]
  },
  {
    "id": "fox-at-dawn",
    "name": "Fox at Dawn",
    "description": "A red fox probes the chicken yard in the pre-dawn hour.",
    "trigger": {
      "type": "forest-edge-adjacent",
      "params": { "unfenced_coop": true, "min_forest_edge_tiles": 6 },
      "season_any": ["spring", "autumn", "winter"],
      "probability": 0.04
    },
    "severity": "real-loss",
    "effects": [
      { "type": "lose-animals", "params": { "min": 1, "max": 2, "species": ["chicken-layer", "duck"] } }
    ],
    "mitigations": [
      { "type": "fenced-coop", "params": {}, "reduces_severity_by": 0.85 },
      { "type": "closed-coop-at-night", "params": {}, "reduces_severity_by": 0.75 },
      { "type": "guard-animal-nearby", "params": { "species": ["lgd_dog", "goose-embden"] }, "reduces_severity_by": 0.9 }
    ],
    "duration_days_range": [1, 1]
  },
  {
    "id": "raccoon-raid",
    "name": "Raccoon Raid",
    "description": "A raccoon reaches into the coop at night for eggs or young chicks.",
    "trigger": {
      "type": "night-coop-open",
      "params": { "open_compost_nearby": true },
      "season_any": ["summer", "autumn"],
      "probability": 0.06
    },
    "severity": "real-loss",
    "effects": [
      { "type": "lose-animals", "params": { "min": 1, "max": 2, "species": ["chicken-layer", "duck"] } },
      { "type": "lose-resource", "params": { "kind": "eggs", "min": 1, "max": 3 } }
    ],
    "mitigations": [
      { "type": "closed-coop-at-night", "params": {}, "reduces_severity_by": 0.90 },
      { "type": "fenced-coop", "params": {}, "reduces_severity_by": 0.65 },
      { "type": "guard-animal-nearby", "params": { "species": ["lgd_dog"] }, "reduces_severity_by": 0.80 }
    ],
    "duration_days_range": [1, 1]
  },
  {
    "id": "heron-visit",
    "name": "Great Blue Heron Visit",
    "description": "A heron fishes the pond; small trout stock drops.",
    "trigger": {
      "type": "pond-with-fish",
      "params": { "min_fish_stock": 2 },
      "season_any": ["spring", "summer", "autumn"],
      "probability": 0.05
    },
    "severity": "real-loss",
    "effects": [
      { "type": "lose-animals", "params": { "min": 1, "max": 2, "species": ["rainbow-trout"] } }
    ],
    "mitigations": [
      { "type": "duck-flock", "params": { "min_ducks": 3 }, "reduces_severity_by": 0.6 },
      { "type": "heron-deterrent", "params": {}, "reduces_severity_by": 0.85 }
    ],
    "duration_days_range": [1, 1]
  }
]
